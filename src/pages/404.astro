---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titulo="Página no encontrada">
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-sm font-medium uppercase tracking-widest text-amber-800">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold text-stone-900">No encontramos esa página</h1>
    <p class="mt-4 text-stone-600">Puede que el enlace esté mal escrito o que el café ya no esté en el catálogo.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/cafes" class="rounded-lg bg-amber-500 px-6 py-3 font-semibold text-stone-900 hover:bg-amber-400">Ver los cafés</a>
      <a href="/" class="rounded-lg border border-stone-300 px-6 py-3 font-semibold text-stone-700 hover:bg-stone-100">Ir al inicio</a>
    </div>
  </div>
</BaseLayout>