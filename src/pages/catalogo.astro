---
import BaseLayout from '../layouts/BaseLayout.astro';
import CafeCard from '../components/CafeCard.astro';
import { cafes } from '../data/cafes';
---

<BaseLayout titulo="Catálogo" descripcion="Nuestros cafés de origen: Etiopía, Colombia, Brasil y Guatemala">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-bold text-stone-900">Nuestros cafés</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-600">
      Cuatro cafés de origen, tostados por nosotros en pequeñas tandas. Los precios son por paquete de 250 g.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      {cafes.map((cafe) => <CafeCard {...cafe} />)}
    </div>
  </div>
</BaseLayout>