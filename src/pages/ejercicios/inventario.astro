---
import BaseLayout from '../../layouts/BaseLayout.astro';

const API = import.meta.env.WP_API_URL;
const POR_PAGINA = 3;

// 1) Primera petición: nos da los datos de la página 1 y las cabeceras con los totales.
const primera = await fetch(`${API}/wp/v2/cafes?per_page=${POR_PAGINA}&page=1&_fields=id,title`);
if (!primera.ok) {
  throw new Error(`WordPress respondió ${primera.status} al pedir los cafés`);
}

// Las cabeceras llegan como texto: las pasamos a número.
const total = Number(primera.headers.get('X-WP-Total'));
const totalPaginas = Number(primera.headers.get('X-WP-TotalPages'));

// 2) RETO: con TotalPages, pedimos el resto de páginas y juntamos los nombres.
const nombres: string[] = (await primera.json()).map((c: any) => c.title.rendered);

for (let pagina = 2; pagina <= totalPaginas; pagina++) {
  const respuesta = await fetch(
    `${API}/wp/v2/cafes?per_page=${POR_PAGINA}&page=${pagina}&_fields=id,title`
  );
  if (!respuesta.ok) {
    throw new Error(`WordPress respondió ${respuesta.status} en la página ${pagina}`);
  }
  const datos = await respuesta.json();
  nombres.push(...datos.map((c: any) => c.title.rendered));
}
---

<BaseLayout titulo="Inventario">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-stone-900">Inventario de cafés</h1>

    <p class="mt-4 text-lg text-stone-700">
      Hay {total} cafés repartidos en {totalPaginas} páginas.
    </p>

    <h2 class="mt-8 text-xl font-semibold text-stone-900">Lista completa</h2>
    <ul class="mt-3 list-disc space-y-1 pl-6 text-stone-700">
      {nombres.map((nombre) => <li set:html={nombre} />)}
    </ul>
  </div>
</BaseLayout>