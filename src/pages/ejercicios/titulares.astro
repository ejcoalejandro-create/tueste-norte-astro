---
// DÓNDE APARECE EL console.log Y POR QUÉ:
// Aparece en la TERMINAL donde corre `npm run dev` (o `npm run build`), no en
// la consola del navegador. El frontmatter se ejecuta en Node, en el servidor
// o durante el build, y nunca llega al navegador. El navegador solo recibe el
// HTML ya generado, así que desde allí no se puede ver ese log.

import BaseLayout from '../../layouts/BaseLayout.astro';

const API = import.meta.env.WP_API_URL;

const respuesta = await fetch(`${API}/wp/v2/posts`);
if (!respuesta.ok) {
  throw new Error(`WordPress respondió ${respuesta.status} al pedir las entradas`);
}

const entradas = await respuesta.json();
console.log(`Entradas recibidas: ${entradas.length}`);
---

<BaseLayout titulo="Titulares">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-stone-900">Titulares del blog</h1>

    <ul class="mt-6 list-disc space-y-2 pl-6 text-stone-700">
      {entradas.map((entrada: any) => (
        <li>
          <span set:html={entrada.title.rendered} />
          ({new Date(entrada.date).toLocaleDateString('es-ES')})
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>