---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import { getCafe, type Cafe } from '../../lib/wp';

const { slug } = Astro.params;

let cafe: Cafe | null = null;
let hayError = false;

try {
  cafe = await getCafe(slug ?? '');
} catch (error) {
  console.error(error);
  hayError = true;
  Astro.response.status = 503;
}

// WordPress respondió bien pero no existe ese café: 404.
if (!cafe && !hayError) {
  return Astro.rewrite('/404');
}

if (cafe) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
}

const precioTexto =
  cafe && cafe.precio !== null
    ? cafe.precio.toLocaleString('es-ES', { style: 'currency', currency: 'EUR' })
    : null;
---

<BaseLayout titulo={cafe?.nombre ?? 'Café'} descripcion={cafe?.extracto || undefined}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <a href="/cafes" class="text-sm text-amber-800 hover:underline">← Todos los cafés</a>

    {cafe ? (
      <article class="mt-4">
        <h1 class="text-4xl font-bold text-stone-900">{cafe.nombre}</h1>

        <div class="mt-4 flex flex-wrap gap-2">
          {cafe.tuesteSemana && <Badge texto="Tueste de la semana" tono="nuevo" />}
          {cafe.tueste && <Badge texto={`tueste ${cafe.tueste}`} tono="tueste" />}
          {cafe.origen && <Badge texto={cafe.origen} tono="origen" />}
        </div>

        {cafe.imagen && (
          <img
            src={cafe.imagen}
            alt={cafe.nombre}
            class="mt-6 aspect-[4/3] w-full rounded-xl object-cover"
          />
        )}

        <dl class="mt-8 grid grid-cols-1 gap-6 rounded-xl border border-stone-200 bg-white p-6 sm:grid-cols-2">
          {cafe.origen && (
            <div>
              <dt class="text-sm font-medium text-stone-500">Origen</dt>
              <dd class="mt-1 text-stone-800">{cafe.origen}</dd>
            </div>
          )}
          {cafe.tueste && (
            <div>
              <dt class="text-sm font-medium text-stone-500">Nivel de tueste</dt>
              <dd class="mt-1 capitalize text-stone-800">{cafe.tueste}</dd>
            </div>
          )}
          {cafe.notas && (
            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-stone-500">Notas de cata</dt>
              <dd class="mt-1 italic text-stone-800">{cafe.notas}</dd>
            </div>
          )}
          {precioTexto && (
            <div>
              <dt class="text-sm font-medium text-stone-500">Precio</dt>
              <dd class="mt-1 text-2xl font-bold text-amber-800">
                {precioTexto} <span class="text-sm font-normal text-stone-400">/ 250 g</span>
              </dd>
            </div>
          )}
        </dl>

        <div class="prose prose-stone mt-8 max-w-none" set:html={cafe.descripcionHtml} />
      </article>
    ) : (
      <p class="mt-8 rounded-xl border border-amber-300 bg-amber-50 p-6 text-stone-700">
        Ahora mismo no podemos cargar este café. Inténtalo de nuevo en unos minutos.
      </p>
    )}
  </div>
</BaseLayout>