---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  aviso: CollectionEntry<'avisos'>;
}

const { aviso } = Astro.props;
const { Content } = await render(aviso);
const { titulo, fecha, importante } = aviso.data;
---

<article
  class:list={[
    'rounded-xl border p-6',
    importante ? 'border-amber-400 bg-amber-50' : 'border-stone-200 bg-white',
  ]}
>
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-xl font-semibold text-stone-900">{titulo}</h2>
    {importante && (
      <span class="rounded-full bg-amber-200 px-3 py-1 text-xs font-bold uppercase text-amber-900">
        Importante
      </span>
    )}
  </div>
  <time
    datetime={fecha.toISOString()}
    class="mt-1 block text-sm text-stone-500"
  >
    {fecha.toLocaleDateString('es-ES', { dateStyle: 'long' })}
  </time>
  <div class="mt-4 text-stone-700">
    <Content />
  </div>
</article>