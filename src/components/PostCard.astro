---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
---

<article class="rounded-xl border border-stone-200 bg-white p-6 transition-shadow hover:shadow-md">
  <time datetime={pubDate.toISOString()} class="text-sm text-stone-500">
    {pubDate.toLocaleDateString('es-ES', { dateStyle: 'long' })}
  </time>
  <h2 class="mt-1 text-xl font-semibold text-stone-900">
    <a href={`/blog/${post.id}`} class="hover:text-amber-800">{title}</a>
  </h2>
  <p class="mt-2 text-stone-600">{description}</p>
</article>