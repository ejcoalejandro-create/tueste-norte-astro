---
const enlaces = [
  { texto: 'Inicio', href: '/' },
  { texto: 'Quiénes somos', href: '/quienes-somos' },
  { texto: 'Avisos', href: '/avisos' },
];
---

<header class="border-b border-stone-200 bg-white">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <a href="/" class="text-xl font-bold tracking-wide text-stone-900">
      Tueste Norte
    </a>
    <ul class="flex gap-6 text-stone-600">
      {enlaces.map((enlace) => (
        <li>
          <a href={enlace.href} class="hover:text-amber-800">{enlace.texto}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>