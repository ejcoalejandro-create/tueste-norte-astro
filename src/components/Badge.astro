---
interface Props {
  texto: string;
  tono: 'tueste' | 'origen' | 'nuevo';
}

const { texto, tono } = Astro.props;

const estilos = {
  tueste: 'bg-amber-100 text-amber-900',
  origen: 'bg-stone-200 text-stone-800',
  nuevo: 'bg-emerald-100 text-emerald-800',
};
---

<span
  class:list={[
    'inline-block rounded-full px-3 py-1 text-sm font-medium',
    estilos[tono],
  ]}
>
  {texto}
</span>