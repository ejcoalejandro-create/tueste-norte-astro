---
import Badge from './Badge.astro';
import type { Cafe } from '../lib/wp';

type Props = Cafe;

const { slug, nombre, origen, notas, tueste, precio, imagen, tuesteSemana } = Astro.props;

const precioTexto =
  precio !== null
    ? precio.toLocaleString('es-ES', { style: 'currency', currency: 'EUR' })
    : null;
---

<article class="flex h-full flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md">
  {imagen && (
    <a href={`/cafes/${slug}`}>
      <img src={imagen} alt={nombre} loading="lazy" class="aspect-[4/3] w-full object-cover" />
    </a>
  )}

  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap gap-2">
      {tuesteSemana && <Badge texto="Tueste de la semana" tono="nuevo" />}
      {tueste && <Badge texto={`tueste ${tueste}`} tono="tueste" />}
      {origen && <Badge texto={origen} tono="origen" />}
    </div>

    <h3 class="mt-4 text-xl font-bold text-stone-900">
      <a href={`/cafes/${slug}`} class="hover:text-amber-800">{nombre}</a>
    </h3>

    <p class="mt-2 flex-1 italic text-stone-600">{notas}</p>

    {precioTexto && (
      <p class="mt-4 text-lg font-semibold text-amber-800">
        {precioTexto}
        <span class="text-sm font-normal text-stone-400">/ 250 g</span>
      </p>
    )}
  </div>
</article>